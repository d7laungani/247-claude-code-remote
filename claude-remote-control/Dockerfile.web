# syntax=docker/dockerfile:1
FROM node:20-slim AS base

RUN npm install -g pnpm@9

WORKDIR /app

# Copy package files and config for dependency install
# Supports both repo-root context (GitHub-connected deploys) and
# claude-remote-control/ context (manual `railway up` from subdirectory)
COPY claude-remote-control/package.json claude-remote-control/pnpm-lock.yaml claude-remote-control/pnpm-workspace.yaml claude-remote-control/turbo.json claude-remote-control/tsconfig.json ./
COPY claude-remote-control/apps/web/package.json ./apps/web/
COPY claude-remote-control/packages/shared/package.json ./packages/shared/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY claude-remote-control/packages/shared/ ./packages/shared/
COPY claude-remote-control/apps/web/ ./apps/web/

# Build shared package first, then web
RUN pnpm build

# Production stage
FROM node:20-slim AS runner
WORKDIR /app

COPY --from=base /app/apps/web/.next/standalone ./
COPY --from=base /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=base /app/apps/web/public ./apps/web/public

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
